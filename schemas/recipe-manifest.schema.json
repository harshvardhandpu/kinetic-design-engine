{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/recipe-manifest@0.1",
  "title": "Kinetic Recipe Manifest",
  "description": "Named experience composition (doc 07). Registry item whose registryDependencies are pinned primitives/components/blocks.",
  "type": "object",
  "required": ["name", "title", "meta"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "type": { "const": "registry:block" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "registryDependencies": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Pinned primitive/component ids (name#version)." },
    "files": { "type": "array", "items": { "type": "object" } },
    "meta": {
      "type": "object",
      "required": ["kinetic"],
      "properties": {
        "kinetic": {
          "type": "object",
          "required": ["kind", "purpose", "surface_compatibility", "visual_posture", "required_primitives", "timeline", "interaction_model", "performance_class", "mobile_fallback", "reduced_motion_fallback", "protagonist"],
          "properties": {
            "kind": { "const": "recipe" },
            "purpose": { "type": "string", "maxLength": 200 },
            "surface_compatibility": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["monitor", "operate", "compare", "configure", "decide-learn", "explore", "command-inspect"] } },
            "visual_posture": { "type": "string", "enum": ["calm", "confident", "cinematic", "playful"] },
            "required_primitives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "optional_primitives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "perf_class_delta": { "type": "string" }
                }
              }
            },
            "protagonist": { "type": "string", "description": "The ONE protagonist primitive (doc 07 rule 1)." },
            "timeline": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": { "type": "string" },
                "entry_sequence": { "type": "array", "items": { "type": "string" } },
                "stagger_map": { "type": "object" },
                "scroll_binding": { "type": "string", "enum": ["none", "reveal", "scrub", "pin"] }
              }
            },
            "interaction_model": { "type": "string", "enum": ["none", "hover", "click", "drag", "scroll-scrub", "combined"] },
            "performance_class": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"], "description": "Aggregate worst-case simultaneous cost (doc 07 rule 2)." },
            "mobile_fallback": { "type": "object", "required": ["chain"], "properties": { "chain": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "description": { "type": "string" } } },
            "reduced_motion_fallback": { "type": "object", "required": ["end_state"], "properties": { "end_state": { "type": "string" }, "description": { "type": "string" } } },
            "stack_requirements": { "type": "array", "items": { "type": "string" } },
            "token_overrides": { "type": "object", "description": "Recipe-level kinetic.* token deltas within K-level envelope." },
            "source_inspiration": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}

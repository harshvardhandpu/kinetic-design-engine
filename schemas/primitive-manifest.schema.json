{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/primitive-manifest@0.1",
  "title": "Kinetic Primitive Manifest",
  "description": "Superset of shadcn registry-item.json. Base fields follow https://ui.shadcn.com/schema/registry-item.json; KINETIC governance lives in meta.kinetic.",
  "type": "object",
  "required": ["name", "type", "title", "files", "meta"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Stable id; must be semantically true (doc 03 P16)." },
    "type": { "type": "string", "enum": ["registry:ui", "registry:block", "registry:component", "registry:hook", "registry:lib", "registry:page", "registry:file"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dependencies": { "type": "array", "items": { "type": "string" }, "description": "npm packages, name@version." },
    "devDependencies": { "type": "array", "items": { "type": "string" } },
    "registryDependencies": { "type": "array", "items": { "type": "string" }, "description": "bare | @ns/item | owner/repo/item#ref | URL | path. Each dep pinned (refs not inherited)." },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "role": { "type": "string", "enum": ["source", "example", "doc", "token"], "description": "jsrepo-style role; example files ship with the item for agent inspection." },
          "content": { "type": "string" }
        }
      }
    },
    "cssVars": { "type": "object" },
    "tailwind": { "type": "object" },
    "css": { "type": "array", "items": { "type": "string" } },
    "docs": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "meta": {
      "type": "object",
      "required": ["kinetic"],
      "properties": {
        "kinetic": {
          "type": "object",
          "required": ["kind", "family", "surface_types", "kinetic_levels", "performance_class", "motion_purpose", "reduced_motion_policy", "no_js_state", "implementation_ladder", "source_inspiration", "verification"],
          "properties": {
            "kind": { "const": "primitive" },
            "family": { "type": "string", "enum": ["reveal", "typography", "scroll", "pointer", "microinteraction", "transition", "spatial", "particles", "ambient", "navigation", "layout-motion", "feedback"] },
            "surface_types": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["monitor", "operate", "compare", "configure", "decide-learn", "explore", "command-inspect"] } },
            "kinetic_levels": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["K0", "K1", "K2", "K3", "K4", "K5"] } },
            "performance_class": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
            "motion_intensity": { "type": "string", "enum": ["subtle", "moderate", "strong"] },
            "motion_purpose": { "type": "string", "enum": ["functional", "expressive", "decorative"] },
            "mobile_policy": { "type": "string", "enum": ["full", "simplify", "static-fallback"] },
            "reduced_motion_policy": { "type": "string", "enum": ["static-end-state", "simplified", "unchanged"] },
            "no_js_state": { "type": "string", "enum": ["content-visible-effect-absent", "static-composition", "not-applicable"] },
            "implementation_ladder": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["css", "waapi", "framework-motion", "gsap", "canvas2d", "webgl", "webgpu"] }, "description": "Ordered simplest-first (doc 23 router)." },
            "layout_reads": { "type": "string", "enum": ["none", "batched", "per-frame"], "default": "none", "description": "per-frame is a publish-gate lint error (doc 15)." },
            "scrubbable": { "type": "boolean", "default": true, "description": "Motion handle exposes seek() (doc 12)." },
            "limits": {
              "type": "object",
              "properties": {
                "max_nodes": { "type": "integer" },
                "max_particles": { "type": "integer" },
                "max_canvas_px": { "type": "integer" }
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["number", "string", "boolean", "enum", "function", "token"] },
                  "token": { "type": "string", "description": "kinetic.* token this input binds to (doc 08)." },
                  "default": {},
                  "enum_values": { "type": "array" }
                }
              }
            },
            "variants": { "type": "array", "items": { "type": "string" } },
            "conflicts": { "type": "array", "items": { "type": "string" } },
            "source_inspiration": {
              "type": "array",
              "description": "Provenance, not clone permission (doc 03 P11).",
              "items": {
                "type": "object",
                "required": ["ref", "evidence"],
                "properties": {
                  "ref": { "type": "string", "description": "Source id from docs/01-source-inventory.md or url:." },
                  "url": { "type": "string" },
                  "evidence": { "type": "string", "enum": ["DIRECTLY-INSPECTED", "VISUALLY-INSPECTED", "TEXT-ONLY", "METADATA-ONLY", "SECONDARY-SOURCE"] },
                  "claim": { "type": "string" }
                }
              }
            },
            "verification": {
              "type": "object",
              "required": ["checks"],
              "properties": {
                "demo_route": { "type": "string" },
                "checks": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Evaluator check ids that must pass on the demo (doc 13)." }
              }
            },
            "install_strategy": { "type": "string", "enum": ["copy", "copy+config", "config-only"], "default": "copy" },
            "kinetic_ids": { "type": "string", "enum": ["auto", "manual", "none"], "default": "auto", "description": "data-kinetic-* emission (doc 11)." },
            "accessibility": {
              "type": "object",
              "description": "Doc 16 contract; all fields required at publish gate.",
              "properties": {
                "keyboard_behavior": { "type": "string" },
                "focus_behavior": { "type": "string" },
                "screen_reader_impact": { "type": "string" },
                "contrast_impact": { "type": "string" },
                "motion_sensitivity": { "type": "string", "enum": ["none", "mild", "vestibular-trigger"] },
                "flashing_risk": { "type": "string", "enum": ["none", "declared-rate"] },
                "touch_alternative": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

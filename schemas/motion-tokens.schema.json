{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/motion-tokens.schema.json",
  "title": "KineticMotionTokenCatalog",
  "description": "Machine-readable approved motion token catalogue; token data is added in S16.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "evidence_tags", "tokens", "aliases"],
  "properties": {
    "schema": { "const": "kinetic/motion-tokens@0.1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "evidence_tags": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "tokens": { "type": "object", "additionalProperties": { "$ref": "#/$defs/token" } },
    "aliases": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "token": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "value", "unit", "evidence_tag", "reduced_motion_value"],
      "properties": {
        "category": { "enum": ["duration", "delay", "stagger", "easing", "distance", "opacity", "scale", "spring", "speed", "depth"] },
        "value": { "type": ["string", "number"] },
        "unit": { "enum": ["ms", "s", "px", "ratio", "unitless", "css-easing", "spring", "percent"] },
        "evidence_tag": { "type": "string", "minLength": 1 },
        "reduced_motion_value": { "type": ["string", "number", "null"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/gym/retrieval-receipt.schema.json",
  "title": "Phase25RetrievalReceipt",
  "description": "Deterministic rights-filtered retrieval provenance for one candidate plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "case_id", "variant_id", "query", "normalized_tokens", "filters", "registry_version", "registry_sha256", "index_hashes", "design_cases_retrieved", "sources_retrieved", "rejected_candidates", "recipes_selected", "primitives_selected", "tools_selected", "obsidian_notes_used", "created_at"],
  "properties": {
    "schema": { "const": "kinetic/gym/retrieval-receipt@0.1" },
    "receipt_id": { "type": "string", "pattern": "^rr-[0-9a-z-]+$" },
    "case_id": { "type": "string", "pattern": "^case-[0-9a-z-]+$" },
    "variant_id": { "type": "string", "pattern": "^V[0-9]+$" },
    "query": { "type": "string", "minLength": 1 },
    "normalized_tokens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "filters": { "type": "object", "additionalProperties": { "type": ["string", "array", "boolean", "null"] } },
    "registry_version": { "const": "0.1.2" },
    "registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "index_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "design_cases_retrieved": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/designCaseSelection" } },
    "sources_retrieved": { "type": "array", "items": { "$ref": "#/$defs/sourceSelection" } },
    "rejected_candidates": { "type": "array", "items": { "$ref": "#/$defs/rejection" } },
    "recipes_selected": { "type": "array", "items": { "$ref": "#/$defs/namedSelection" } },
    "primitives_selected": { "type": "array", "items": { "$ref": "#/$defs/namedSelection" } },
    "tools_selected": { "type": "array", "items": { "$ref": "#/$defs/namedSelection" } },
    "obsidian_notes_used": { "type": "array", "items": { "$ref": "#/$defs/obsidianNote" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonemptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "designCaseSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "score", "retrieval_reason", "knowledge_used"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^case-[0-9a-z-]+$" },
        "score": { "type": "number", "minimum": 0 },
        "retrieval_reason": { "type": "string", "minLength": 1 },
        "knowledge_used": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "sourceSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "score", "retrieval_reason", "knowledge_used", "usage_mode", "rights_allowed", "rights_evidence_urls"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "score": { "type": "number", "minimum": 0 },
        "retrieval_reason": { "type": "string", "minLength": 1 },
        "knowledge_used": { "$ref": "#/$defs/nonemptyStrings" },
        "usage_mode": { "enum": ["PRINCIPLE", "PATTERN", "RECIPE", "PRIMITIVE", "TOOL", "BUILD_DEPENDENCY", "COMPARISON_REFERENCE"] },
        "rights_allowed": { "const": true },
        "rights_evidence_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
      }
    },
    "rejection": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "reason"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "namedSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "obsidianNote": {
      "type": "object", "additionalProperties": false,
      "required": ["note_path", "kinetic_source_id", "reason_retrieved", "knowledge_used", "trust_level", "content_sha256"],
      "properties": {
        "note_path": { "type": "string", "minLength": 1 },
        "kinetic_source_id": { "type": ["string", "null"], "pattern": "^src-[a-z0-9-]+$" },
        "reason_retrieved": { "type": "string", "minLength": 1 },
        "knowledge_used": { "$ref": "#/$defs/nonemptyStrings" },
        "trust_level": { "enum": ["ACCEPTED_DECISION", "CANONICAL_CONCEPT", "VERIFIED_SOURCE_SYNTHESIS", "UNVERIFIED_NOTE"] },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

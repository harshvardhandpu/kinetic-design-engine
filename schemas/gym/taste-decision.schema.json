{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/gym/taste-decision.schema.json",
  "title": "TasteDecision",
  "description": "One immutable human judgment event. Append-only. Doc: docs/gym/41-taste-memory.md",
  "type": "object",
  "required": ["schema", "decision_id", "context", "candidates", "outcome", "reviewer", "timestamp"],
  "properties": {
    "schema": { "const": "kinetic/gym/taste-decision@0.1" },
    "decision_id": { "type": "string", "pattern": "^td-[0-9]{8}-[0-9a-z]+(?:-[0-9a-z]+)*$" },
    "context": {
      "type": "object",
      "required": ["surface"],
      "properties": {
        "case_id": { "type": ["string", "null"] },
        "batch_id": { "type": ["string", "null"] },
        "surface": { "type": "string" },
        "industry": { "type": ["string", "null"] },
        "goal": { "type": ["string", "null"] },
        "k_level": { "type": ["string", "null"], "pattern": "^K[0-5]$" }
      }
    },
    "candidates": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "variant run ids shown" },
    "outcome": {
      "type": "object",
      "required": ["winner"],
      "properties": {
        "result": { "enum": ["WINNER_SELECTED", "REJECT_ALL"], "description": "First-class review outcome. REJECT_ALL means none of the above met the human quality floor." },
        "winner": { "type": ["string", "null"], "description": "variant run id, or null when no winner is accepted" },
        "runner_up": { "type": ["string", "null"] },
        "rejected": { "type": "array", "items": { "type": "string" } },
        "none_reason": { "enum": ["not_reviewed", "none_qualified", "none_acceptable", "aborted", null] },
        "relative_preference": {
          "type": "object",
          "description": "Weak relative signal; independent of the absolute quality floor.",
          "required": ["positive_candidates", "ordered", "strength"],
          "properties": {
            "positive_candidates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "ordered": { "type": "boolean" },
            "strength": { "enum": ["weak", "moderate", "strong"] }
          }
        },
        "quality_floor": {
          "type": "object",
          "description": "Absolute human quality-floor judgment; takes precedence over relative preference.",
          "required": ["passed"],
          "properties": {
            "passed": { "type": "boolean" },
            "human_perceived_quality_gap": { "enum": ["none", "minor", "moderate", "substantial", null] }
          }
        }
      },
      "allOf": [
        { "if": { "required": ["result"], "properties": { "result": { "const": "REJECT_ALL" } } },
          "then": { "properties": { "winner": { "const": null }, "quality_floor": { "required": ["passed"], "properties": { "passed": { "const": false } } } }, "required": ["quality_floor"] } },
        { "if": { "required": ["result"], "properties": { "result": { "const": "WINNER_SELECTED" } } },
          "then": { "properties": { "winner": { "type": "string" } } } }
      ]
    },
    "pairwise": {
      "type": "array",
      "description": "fine-grained A-over-B rows (doc 42)",
      "items": {
        "type": "object",
        "required": ["preferred", "over"],
        "properties": {
          "preferred": { "type": "string" },
          "over": { "type": "string" },
          "reasons": { "type": "array", "items": { "$ref": "#/$defs/reason_tag" } }
        }
      }
    },
    "reason_tags": { "type": "array", "items": { "$ref": "#/$defs/reason_tag" } },
    "freeform": { "type": ["string", "null"], "description": "human's own words, verbatim" },
    "first_shot": { "type": ["boolean", "null"], "description": "winner from FIRST generation round; feeds north-star metric (doc 54)" },
    "reviewer": { "type": "string", "description": "default 'user'; future multi-reviewer weighting" },
    "supersedes": { "type": ["string", "null"], "description": "decision_id corrected by this one; decisions are never edited" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "reason_tag": {
      "enum": ["hierarchy", "typography", "spacing", "color", "motion-purpose",
               "motion-quality", "originality", "density", "interaction",
               "navigation", "accessibility", "performance", "surface-fit",
               "brand-fit", "responsive", "other"]
    },
    "phase25": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "decision_id", "context", "candidates", "outcome", "reason_tags", "freeform", "reviewer", "supersedes", "timestamp"],
      "properties": {
        "schema": { "const": "kinetic/gym/taste-decision@0.2" },
        "decision_id": { "type": "string", "pattern": "^td-[0-9]{8}-[0-9a-z]+(?:-[0-9a-z]+)*$" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["case_id", "batch_id", "surface", "goal"],
          "properties": {
            "case_id": { "type": "string", "pattern": "^case-[0-9a-z-]+$" },
            "batch_id": { "type": "string", "minLength": 1 },
            "surface": { "type": "string", "minLength": 1 },
            "goal": { "type": "string", "minLength": 1 }
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["V1", "V2"] }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "relative_preference", "winner", "candidate_decisions"],
          "properties": {
            "result": { "enum": ["WINNER_SELECTED", "PARTIAL_ACCEPTANCE", "REJECT_ALL"] },
            "relative_preference": { "enum": ["V1", "V2", "tie", "neither"] },
            "winner": { "type": ["string", "null"], "enum": ["V1", "V2", null] },
            "candidate_decisions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["V1", "V2"],
              "properties": {
                "V1": { "$ref": "#/$defs/phase25CandidateDecision" },
                "V2": { "$ref": "#/$defs/phase25CandidateDecision" }
              }
            }
          }
        },
        "reason_tags": { "type": "array", "items": { "$ref": "#/$defs/reason_tag" } },
        "freeform": { "type": ["string", "null"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "supersedes": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "properties": { "result": { "const": "WINNER_SELECTED" } } } } },
          "then": { "properties": { "outcome": { "properties": { "winner": { "type": "string" } } } } }
        },
        {
          "if": { "properties": { "outcome": { "properties": { "result": { "const": "PARTIAL_ACCEPTANCE" } } } } },
          "then": { "properties": { "outcome": { "properties": { "winner": { "const": null } } } } }
        },
        {
          "if": { "properties": { "outcome": { "properties": { "result": { "const": "REJECT_ALL" } } } } },
          "then": {
            "properties": {
              "outcome": {
                "properties": {
                  "winner": { "const": null },
                  "candidate_decisions": {
                    "properties": {
                      "V1": { "properties": { "quality_floor_passed": { "const": false }, "acceptable_for_further_taste_learning": { "const": false } } },
                      "V2": { "properties": { "quality_floor_passed": { "const": false }, "acceptable_for_further_taste_learning": { "const": false } } }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "phase25CandidateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_floor_passed", "acceptable_for_further_taste_learning", "reason"],
      "properties": {
        "quality_floor_passed": { "type": "boolean" },
        "acceptable_for_further_taste_learning": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}

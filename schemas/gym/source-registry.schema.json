{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/gym/source-registry.schema.json",
  "title": "KineticSourceRegistry",
  "description": "Authoritative registry of inspiration, implementation, and tool sources with conservative rights policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "training_definition", "sources"],
  "properties": {
    "schema": { "const": "kinetic/gym/source-registry@0.1" },
    "updated": { "type": "string", "format": "date" },
    "training_definition": {
      "const": "retrieval/design-pattern/tool/evaluator/negative/taste knowledge only; no foundation-model weight training"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "canonical_url",
        "domain",
        "source_kind",
        "knowledge_domains",
        "license_status",
        "terms_url",
        "license_url",
        "rights_status",
        "ai_training_status",
        "automated_access",
        "asset_copy",
        "code_ingest",
        "credential_required",
        "attribution_required",
        "license_retention_required",
        "inspection_quality",
        "last_verified_at",
        "evidence_urls",
        "ingestion_modes",
        "audit",
        "notes"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "format": "uri" },
        "domain": { "type": "string", "minLength": 1 },
        "source_kind": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DESIGN_REFERENCE",
              "MOTION_REFERENCE",
              "IMPLEMENTATION_LIBRARY",
              "COMPONENT_LIBRARY",
              "TYPOGRAPHY_REFERENCE",
              "BRAND_REFERENCE",
              "NAVIGATION_REFERENCE",
              "SECTION_REFERENCE",
              "TOOL_DIRECTORY",
              "TOOL",
              "MCP",
              "LICENSE_GATED_LIBRARY"
            ]
          }
        },
        "knowledge_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "composition",
              "typography",
              "color",
              "art_direction",
              "navigation",
              "sections",
              "motion",
              "transition",
              "interaction",
              "microinteraction",
              "3d",
              "canvas",
              "shaders",
              "icons",
              "branding",
              "logo",
              "app_store",
              "responsive",
              "accessibility",
              "implementation",
              "tooling"
            ]
          }
        },
        "license_status": {
          "enum": [
            "VERIFIED_OPEN_SOURCE",
            "VERIFIED_PROPRIETARY",
            "MIXED_FREE_AND_LICENSED",
            "UNVERIFIED",
            "NOT_APPLICABLE"
          ]
        },
        "terms_url": { "type": ["string", "null"], "format": "uri" },
        "license_url": { "type": ["string", "null"], "format": "uri" },
        "rights_status": {
          "enum": [
            "ALLOW_CODE_INGEST",
            "ALLOW_ABSTRACT_PATTERN",
            "ALLOW_METADATA_ONLY",
            "REFERENCE_ONLY",
            "TOOL_DISCOVERY_ONLY",
            "LICENSE_GATED",
            "VERIFY_REQUIRED",
            "NO_INGEST"
          ]
        },
        "ai_training_status": {
          "enum": ["EXPLICITLY_ALLOWED", "EXPLICITLY_PROHIBITED", "UNSPECIFIED", "NOT_APPLICABLE"]
        },
        "automated_access": { "enum": ["ALLOWED", "PROHIBITED", "UNKNOWN"] },
        "asset_copy": { "enum": ["ALLOWED", "PROHIBITED", "PER_ITEM", "UNKNOWN"] },
        "code_ingest": { "enum": ["ALLOWED", "PROHIBITED", "PER_ITEM", "LICENSE_GATED", "UNKNOWN"] },
        "credential_required": { "type": "boolean" },
        "attribution_required": { "type": ["boolean", "null"] },
        "license_retention_required": { "type": ["boolean", "null"] },
        "inspection_quality": {
          "enum": [
            "DIRECTLY_INSPECTED",
            "VISUALLY_INSPECTED",
            "TEXT_ONLY",
            "METADATA_ONLY",
            "SECONDARY_SOURCE",
            "INACCESSIBLE"
          ]
        },
        "last_verified_at": { "type": "string", "format": "date" },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "ingestion_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REFERENCE_ABSTRACTION",
              "CODE_RECIPE_INGEST",
              "BUILD_TIME_LIBRARY",
              "TOOL_DISCOVERY_ONLY",
              "LICENSE_GATED_RUNTIME",
              "NO_AUTOMATED_INGEST",
              "VERIFY_REQUIRED"
            ]
          }
        },
        "tier_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "rights_status", "code_ingest", "credential_required", "notes"],
            "properties": {
              "tier": { "type": "string", "minLength": 1 },
              "rights_status": {
                "enum": [
                  "ALLOW_CODE_INGEST",
                  "ALLOW_ABSTRACT_PATTERN",
                  "ALLOW_METADATA_ONLY",
                  "REFERENCE_ONLY",
                  "TOOL_DISCOVERY_ONLY",
                  "LICENSE_GATED",
                  "VERIFY_REQUIRED",
                  "NO_INGEST"
                ]
              },
              "code_ingest": { "enum": ["ALLOWED", "PROHIBITED", "PER_ITEM", "LICENSE_GATED", "UNKNOWN"] },
              "credential_required": { "type": "boolean" },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        },
        "audit": { "$ref": "source-audit-record.schema.json" },
        "notes": { "type": "string" }
      }
    }
  }
}

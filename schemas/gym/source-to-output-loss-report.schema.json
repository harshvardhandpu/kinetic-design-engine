{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinetic/gym/source-to-output-loss-report.schema.json",
  "title": "Phase25SourceToOutputLossReport",
  "description": "Evidence-bound diagnosis of quality loss from source understanding through output evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "report_id", "case_id", "comparison_chain", "stage_findings", "created_at", "producer"],
  "properties": {
    "schema": { "const": "kinetic/gym/source-to-output-loss@0.1" },
    "report_id": { "type": "string", "pattern": "^sol-[0-9a-z-]+$" },
    "case_id": { "type": "string", "pattern": "^case-[0-9a-z-]+$" },
    "comparison_chain": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stage_findings": {
      "type": "object", "additionalProperties": false,
      "required": ["source_inspection", "retrieval", "analysis", "planning", "typography", "assets", "composition", "depth", "motion", "interaction", "implementation", "evaluation"],
      "properties": {
        "source_inspection": { "$ref": "#/$defs/findings" },
        "retrieval": { "$ref": "#/$defs/findings" },
        "analysis": { "$ref": "#/$defs/findings" },
        "planning": { "$ref": "#/$defs/findings" },
        "typography": { "$ref": "#/$defs/findings" },
        "assets": { "$ref": "#/$defs/findings" },
        "composition": { "$ref": "#/$defs/findings" },
        "depth": { "$ref": "#/$defs/findings" },
        "motion": { "$ref": "#/$defs/findings" },
        "interaction": { "$ref": "#/$defs/findings" },
        "implementation": { "$ref": "#/$defs/findings" },
        "evaluation": { "$ref": "#/$defs/findings" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "stage", "subject_from", "subject_to", "label", "observation", "quality_loss", "why", "avoidable", "responsible_subsystem", "source_refs", "capture_refs", "report_refs", "human_feedback_refs", "possible_remediation", "remediation_label", "confidence"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^loss-[0-9a-z-]+$" },
        "stage": { "enum": ["source_inspection", "retrieval", "analysis", "planning", "typography", "assets", "composition", "depth", "motion", "interaction", "implementation", "evaluation"] },
        "subject_from": { "type": "string", "minLength": 1 },
        "subject_to": { "type": "string", "minLength": 1 },
        "label": { "enum": ["SOURCE-DERIVED", "ENGINE-INFERENCE", "HUMAN-FEEDBACK"] },
        "observation": { "type": "string", "minLength": 1 },
        "quality_loss": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "avoidable": { "enum": [true, false, "unknown"] },
        "responsible_subsystem": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/strings" },
        "capture_refs": { "$ref": "#/$defs/strings" },
        "report_refs": { "$ref": "#/$defs/strings" },
        "human_feedback_refs": { "$ref": "#/$defs/strings" },
        "possible_remediation": { "type": "string", "minLength": 1 },
        "remediation_label": { "const": "ENGINE-RECOMMENDATION" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    }
  }
}
